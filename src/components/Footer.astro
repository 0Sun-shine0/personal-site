---
import Icon from './Icon.astro';
import { site, contacts } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap foot__grid">
    <div class="stack gap-xs">
      <span class="mono faint">© {year} {site.name} · {site.location} · 用 Astro 构建</span>
      <span class="mono faint">装完就能用，比功能多更重要。</span>
    </div>

    <nav class="foot__links" aria-label="联系方式与订阅">
      <a href={site.github} target="_blank" rel="me noopener"><Icon name="github" size={15} />GitHub</a>
      <a href="/rss.xml"><Icon name="rss" size={15} />RSS</a>
      {contacts.map((c) => (
        <button class="btn btn--sm" type="button" data-copy={c.value} title={`点击复制${c.label}：${c.value}`}>
          <Icon name={c.icon} size={14} />{c.label} {c.value}
        </button>
      ))}
    </nav>
  </div>
</footer>