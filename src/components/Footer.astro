---
import Icon from './Icon.astro';
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap foot__grid">
    <div class="stack gap-xs">
      <span class="mono faint"> {year} {site.name}（{site.realName}）  用 Astro 构建</span>
      <span class="mono faint">装完就能用，比功能多更重要。</span>
    </div>

    <nav class="foot__links" aria-label="社交与订阅">
      <a href={site.github} target="_blank" rel="me noopener"><Icon name="github" size={15} />GitHub</a>
      <a href="/rss.xml"><Icon name="rss" size={15} />RSS</a>
      <button class="btn btn--sm" type="button" data-copy={site.email}>
        <Icon name="copy" size={14} />{site.email}
      </button>
    </nav>
  </div>
</footer>