---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { featured, projects, followedProjects, site } from '../data/site';
---
<BaseLayout
  title="作品"
  description="颐安做过的项目：小爪助手、T2Video-DCOT，以及几个桌面和自动化工具。"
>
  <section class="page-head">
    <div class="wrap stack gap-sm">
      <nav class="crumb" aria-label="面包屑"><a href="/">首页</a><span aria-hidden="true">/</span><span class="faint">作品</span></nav>
      <span class="eyebrow">作品</span>
        <h1>我做过的东西</h1>
        <p class="lead">
          功能列表没那么重要。这里留下的主要是当时为什么这么选，以及后来发现错在哪。
      </p>
    </div>
  </section>

  <!-- 主推：四段式 -->
  <section class="section section--tight">
    <div class="wrap stack gap-lg">
      {featured.map((p) => (
        <article class="card" id={`p${p.idx}`} data-reveal>
          <div class="card__top">
            <span class="card__idx">{p.idx} — {p.tags.join(' / ')}</span>
            <a class="card__link" href={p.link} target="_blank" rel="noopener">看源码 <Icon name="arrow" cls="btn__icon" /></a>
          </div>

          <h2 style="font-size:clamp(1.35rem,2.7vw,1.95rem);margin-bottom:.6rem">{p.title}</h2>
          <p>{p.summary}</p>

          <div class="case" style="margin-top:1.3rem">
            <div class="case__row">
              <span class="case__key">起因</span>
              <span class="case__val">{p.problem}</span>
            </div>
            <div class="case__row">
              <span class="case__key">做法</span>
              <span class="case__val">{p.approach}</span>
            </div>
            <div class="case__row">
              <span class="case__key">现在</span>
              <span class="case__val" set:html={p.result} />
            </div>
            <div class="case__row">
              <span class="case__key">回头看</span>
              <span class="case__val">{p.lesson}</span>
            </div>
          </div>

          <div class="case__metric">
            {p.metrics.map((m) => <span class="tag tag--brand">{m}</span>)}
            {p.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- 其他作品 -->
  <section class="section section--tight">
    <div class="wrap">
      <div class="section__head" data-reveal>
        <span class="eyebrow">其他作品</span>
        <h2>其他做过的项目</h2>
        <p class="lead">三个不大的项目，各自留下了一点东西。</p>
      </div>

      <div class="stack gap-md">
        {projects.map((p) => (
          <article class="card" id={`p${p.idx}`} data-reveal>
            <div class="card__top">
              <span class="card__idx">{p.idx} — {p.status}</span>
              <a class="card__link" href={p.link} target="_blank" rel="noopener">看源码 <Icon name="arrow" cls="btn__icon" /></a>
            </div>
            <h3 style="font-size:1.2rem">{p.title}</h3>
            <p>{p.subtitle}</p>

            <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));margin-top:1.1rem">
              <ul class="dot-list">
                {p.points.map((x) => <li>{x}</li>)}
              </ul>
              <div class="callout">
                <span aria-hidden="true"><Icon name="spark" size={18} /></span>
                <div><b>做完之后发现</b><br />{p.note}</div>
              </div>
            </div>

            <div class="case__metric">
              <span class="tag tag--brand">{p.stat}</span>
              {p.stack.map((s) => <span class="tag">{s}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 我关注的（不是我的作品） -->
  <section class="section section--tight">
    <div class="wrap">
      <div class="section__head" data-reveal>
        <span class="eyebrow">别人写的</span>
        <h2>关注过的开源项目</h2>
        <p class="lead">这些 <strong>不是我的作品</strong> —— 是学习阶段关注过、fork 到自己账号里方便查的项目。署名和版权都在原作者那里。</p>
      </div>

      <div class="list" data-reveal>
        {followedProjects.map((w) => (
          <div class="list__item">
            <a class="list__link" href={w.link} target="_blank" rel="noopener">
              <span class="list__date">{'@' + w.by}</span>
              <span>
                <span class="list__title">{w.title}</span>
                <span class="list__desc">{w.desc}</span>
              </span>
              <span class="list__arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="cta" data-reveal>
        <h2>想看源码或聊细节？</h2>
        <p>可以从 GitHub 或笔记开始。如果你也在做类似的桌面工具，欢迎直接写信。</p>
        <div class="btn-row" style="justify-content:center">
          <a class="btn btn--primary" href={site.github} target="_blank" rel="me noopener"><Icon name="github" size={16} />GitHub</a>
          <a class="btn" href="/blog">看踩坑笔记 <Icon name="arrow" cls="btn__icon" /></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
