---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, stats, techStack, featured, projects, fmtDate } from '../data/site';

const mods = import.meta.glob('../posts/*.md', { eager: true }) as Record<string, any>;
const posts = Object.entries(mods)
  .map(([p, m]) => ({ slug: p.split('/').pop()!.replace(/\.md$/, ''), ...m.frontmatter }))
  .sort((a, b) => +new Date(b.date) - +new Date(a.date))
  .slice(0, 4);

// 首屏代码窗口：审批链的第一行（示意，实际在 pawpet/ai/tools.py）
const snippet = [
  '<span class="tk-com"># ai/tools.py  审批链的第一行</span>',
  '<span class="tk-key">def</span> <span class="tk-fn">needs_approval</span><span class="tk-punc">(</span>self<span class="tk-punc">,</span> action<span class="tk-punc">,</span> level<span class="tk-punc">)</span> <span class="tk-punc">-&gt;</span> <span class="tk-key">bool</span><span class="tk-punc">:</span>',
  '    <span class="tk-key">if</span> action<span class="tk-punc">.</span>risk <span class="tk-key">is</span> Risk<span class="tk-punc">.</span>CRITICAL<span class="tk-punc">:</span>',
  '        <span class="tk-key">return</span> <span class="tk-num">True</span>   <span class="tk-com"># 装工具 / 跑自定义代码</span>',
  '                     <span class="tk-com"># 写在后面等于没写</span>',
  '    <span class="tk-key">if</span> level <span class="tk-key">is</span> Level<span class="tk-punc">.</span>FULL<span class="tk-punc">:</span>',
  '        <span class="tk-key">return</span> <span class="tk-num">False</span>  <span class="tk-com"># 「完全自动」只免掉日常操作</span>',
  '    <span class="tk-key">return</span> action<span class="tk-punc">.</span>mutates     <span class="tk-com"># 只读的不问你</span>',
].join('\n');

const total = featured.length + projects.length;
---
<BaseLayout>
  <!-- 首屏 -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <span class="pill">
          <span class="dot" aria-hidden="true"></span>{site.status}
        </span>

        <h1>
          {site.headline}<br />
          <span class="grad-text">{site.headlineAccent}</span>
        </h1>

        <p class="hero__sub">{site.intro}</p>

        <div class="btn-row">
          <a class="btn btn--primary" href="/projects">看看我做过什么 <Icon name="arrow" cls="btn__icon" /></a>
          <a class="btn" href="/blog">读踩坑笔记</a>
          <button class="btn" type="button" data-copy={site.github}>
            <Icon name="github" size={15} />GitHub
          </button>
        </div>

        <div class="hero__stats">
          {stats.map((s) => (
            <div>
              <span class="stat__num">{s.num}</span>
              <span class="stat__label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- 右侧：代码窗口 + 浮动数据卡 -->
      <div class="floats">
        <div class="codewin">
          <div class="codewin__bar">
            <span class="codewin__dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="codewin__file">pawpet/ai/tools.py</span>
          </div>
          <pre><code set:html={snippet} /></pre>
        </div>

        <div class="float-card float-card--a">
          <span class="float-card__ico" aria-hidden="true"></span>
          <span>待办 / 番茄钟 <b>完全离线</b></span>
        </div>
        <div class="float-card float-card--b">
          <span class="float-card__ico" aria-hidden="true"></span>
          <span>安装包 <b>约 120MB</b>，双击即用</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 关键词跑马灯 -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {techStack.map((t) => <span>{t}</span>)}
    </div>
    <div class="marquee__track">
      {techStack.map((t) => <span>{t}</span>)}
    </div>
  </div>

  <!-- 主推作品 -->
  <section class="section">
    <div class="wrap">
      <div class="section__head section__head--row" data-reveal>
        <div class="stack gap-sm">
          <span class="eyebrow">主推作品</span>
          <h2>小爪助手：一只会干活的小宠物</h2>
          <p class="lead">
            宠物只是它的脸。真正在干活的是待办、番茄钟、提醒、便签  完全离线、不用注册、数据只存本机。
            AI（看屏幕、替你点键鼠）是可选加成，配不配 API Key 都完整可用。
          </p>
        </div>
        <a class="btn btn--sm" href="/projects">全部 {total} 个项目 <Icon name="arrow" cls="btn__icon" /></a>
      </div>

      <div class="case-grid">
        {featured.map((p, i) => (
          <article class="card" data-reveal style={`--d:${i * 90}ms`}>
            <div class="card__top">
              <span class="card__idx">{p.idx}  {p.tags[0]}</span>
              <a class="card__link" href={`/projects#p${p.idx}`}>案例详情 <Icon name="arrow" cls="btn__icon" /></a>
            </div>
            <h3>{p.title}</h3>
            <p>{p.summary}</p>
            <div class="case" style="margin-top:1.1rem">
              <div class="case__row">
                <span class="case__key">结果</span>
                <span class="case__val" set:html={p.result} />
              </div>
            </div>
            <div class="case__metric">
              {p.metrics.map((m) => <span class="tag tag--brand">{m}</span>)}
            </div>
          </article>
        ))}

        {projects.slice(0, 3).map((p, i) => (
          <article class="card" data-reveal style={`--d:${(i + 1) * 90}ms`}>
            <div class="card__top">
              <span class="card__idx">{p.idx}  {p.stack[0]}</span>
              <a class="card__link" href={`/projects#p${p.idx}`}>看看这个 <Icon name="arrow" cls="btn__icon" /></a>
            </div>
            <h3>{p.title}</h3>
            <p>{p.subtitle}</p>
            <div class="case__metric" style="margin-top:1.1rem">
              <span class="tag tag--brand">{p.stat}</span>
              {p.stack.slice(1).map((s) => <span class="tag">{s}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 最新笔记 -->
  <section class="section section--tight">
    <div class="wrap">
      <div class="section__head section__head--row" data-reveal>
        <div class="stack gap-sm">
          <span class="eyebrow">踩坑笔记</span>
          <h2>踩过的坑，写成能直接抄的做法</h2>
        </div>
        <a class="btn btn--sm" href="/blog">全部笔记 <Icon name="arrow" cls="btn__icon" /></a>
      </div>

      <div class="list" data-reveal>
        {posts.map((post) => (
          <div class="list__item">
            <a class="list__link" href={`/blog/${post.slug}/`}>
              <span class="list__date">{fmtDate(post.date)}</span>
              <span>
                <span class="list__title">{post.title}</span>
                <span class="list__desc">{post.description}</span>
              </span>
              <span class="list__arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 结尾 CTA -->
  <section class="section section--tight">
    <div class="wrap">
      <div class="cta" data-reveal>
        <h2>也在做桌面工具，或者想聊 Agent 设计？</h2>
        <p>权限怎么分级、什么时候该合并确认、打包怎么少踩坑  这些我都踩过一遍，欢迎来交换经验。</p>
        <div class="btn-row" style="justify-content:center">
          <a class="btn btn--primary" href={site.github} target="_blank" rel="me noopener"><Icon name="github" size={16} />去 GitHub 找我</a>
          <a class="btn" href={`mailto:${site.email}`}><Icon name="mail" size={15} />写邮件</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>