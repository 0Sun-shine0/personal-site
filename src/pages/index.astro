---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, stats, techStack, projects, fmtDate } from '../data/site';

const mods = import.meta.glob('../posts/*.md', { eager: true }) as Record<string, any>;
const posts = Object.entries(mods)
  .map(([path, m]) => ({
    slug: path.split('/').pop()!.replace(/\.md$/, ''),
    ...m.frontmatter,
  }))
  .sort((a, b) => +new Date(b.date) - +new Date(a.date))
  .slice(0, 4);

// 首屏代码窗口（写成字符串，避免模板把 Go 的花括号当成表达式）
const snippet = [
  '<span class="tk-com">// 撮合主循环：热路径零分配</span>',
  '<span class="tk-key">func</span> <span class="tk-punc">(</span>e <span class="tk-punc">*</span>Engine<span class="tk-punc">)</span> <span class="tk-fn">Run</span><span class="tk-punc">()</span> <span class="tk-punc">{</span>',
  '    <span class="tk-key">for</span> <span class="tk-punc">{</span>',
  '        <span class="tk-key">select</span> <span class="tk-punc">{</span>',
  '        <span class="tk-key">case</span> od <span class="tk-punc">:=</span> <span class="tk-punc">&lt;-</span>e<span class="tk-punc">.</span>orders<span class="tk-punc">:</span>   <span class="tk-com">// 无锁环形队列</span>',
  '            e<span class="tk-punc">.</span><span class="tk-fn">match</span><span class="tk-punc">(</span>od<span class="tk-punc">)</span>',
  '        <span class="tk-key">case</span> <span class="tk-punc">&lt;-</span>e<span class="tk-punc">.</span>quit<span class="tk-punc">:</span>',
  '            <span class="tk-key">return</span>',
  '        <span class="tk-punc">}</span>',
  '    <span class="tk-punc">}</span>',
  '<span class="tk-punc">}</span>',
].join('\n');
---
<BaseLayout>
  <!-- 首屏 -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <span class="pill">
          <span class="dot" aria-hidden="true"></span>{site.status}  {site.location}
        </span>

        <h1>
          {site.headline}<br />
          <span class="grad-text">{site.headlineAccent}</span>
        </h1>

        <p class="hero__sub">{site.intro}</p>

        <div class="btn-row">
          <a class="btn btn--primary" href="/projects">看看我做过什么 <Icon name="arrow" cls="btn__icon" /></a>
          <a class="btn" href="/blog">读技术笔记</a>
          <button class="btn" type="button" data-copy={site.email}>
            <Icon name="copy" size={15} />复制邮箱
          </button>
        </div>

        <div class="hero__stats">
          {stats.map((s) => (
            <div>
              <span class="stat__num">{s.num}</span>
              <span class="stat__label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- 右侧：代码窗口 + 浮动数据卡 -->
      <div class="floats">
        <div class="codewin">
          <div class="codewin__bar">
            <span class="codewin__dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="codewin__file">engine/hotpath.go</span>
          </div>
          <pre><code set:html={snippet} /></pre>
        </div>

        <div class="float-card float-card--a">
          <span class="float-card__ico" aria-hidden="true"></span>
          <span>P99 <b>38ms  4.2ms</b></span>
        </div>
        <div class="float-card float-card--b">
          <span class="float-card__ico" aria-hidden="true"></span>
          <span>GC 停顿 <b>-97%</b></span>
        </div>
      </div>
    </div>
  </section>

  <!-- 关键词跑马灯 -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {techStack.map((t) => <span>{t}</span>)}
    </div>
    <div class="marquee__track">
      {techStack.map((t) => <span>{t}</span>)}
    </div>
  </div>

  <!-- 精选作品 -->
  <section class="section">
    <div class="wrap">
      <div class="section__head section__head--row" data-reveal>
        <div class="stack gap-sm">
          <span class="eyebrow">精选作品</span>
          <h2>解决问题的记录，不只是截图</h2>
          <p class="lead">
            每个项目都写清楚：谁遇到了什么麻烦、我做了什么决策、数字变成了多少、哪里还能做得更好。
          </p>
        </div>
        <a class="btn btn--sm" href="/projects">全部作品 <Icon name="arrow" cls="btn__icon" /></a>
      </div>

      <div class="case-grid">
        {projects.map((p, i) => (
          <article class="card" data-reveal style={`--d:${i * 90}ms`}>
            <div class="card__top">
              <span class="card__idx">{p.idx}  {p.tags[0]}</span>
              <a class="card__link" href={`/projects#p${p.idx}`}>案例详情 <Icon name="arrow" cls="btn__icon" /></a>
            </div>
            <h3>{p.title}</h3>
            <p>{p.summary}</p>
            <div class="case" style="margin-top:1.1rem">
              <div class="case__row">
                <span class="case__key">结果</span>
                <span class="case__val" set:html={p.result} />
              </div>
            </div>
            <div class="case__metric">
              {p.metrics.map((m) => <span class="tag tag--brand">{m}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 最新文章 -->
  <section class="section section--tight">
    <div class="wrap">
      <div class="section__head section__head--row" data-reveal>
        <div class="stack gap-sm">
          <span class="eyebrow">技术笔记</span>
          <h2>踩过的坑，写成能直接抄的步骤</h2>
        </div>
        <a class="btn btn--sm" href="/blog">全部文章 <Icon name="arrow" cls="btn__icon" /></a>
      </div>

      <div class="list" data-reveal>
        {posts.map((post) => (
          <div class="list__item">
            <a class="list__link" href={`/blog/${post.slug}/`}>
              <span class="list__date">{fmtDate(post.date)}</span>
              <span>
                <span class="list__title">{post.title}</span>
                <span class="list__desc">{post.description}</span>
              </span>
              <span class="list__arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 结尾 CTA -->
  <section class="section section--tight">
    <div class="wrap">
      <div class="cta" data-reveal>
        <h2>有项目想聊，或者只是想交流技术？</h2>
        <p>我正在看后端 / 基础设施方向的机会，也乐意听你讲讲你手上那套系统。</p>
        <div class="btn-row" style="justify-content:center">
          <a class="btn btn--primary" href={`mailto:${site.email}`}><Icon name="mail" size={16} />写信给我</a>
          <button class="btn" type="button" data-copy={site.email}><Icon name="copy" size={15} />复制邮箱</button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>