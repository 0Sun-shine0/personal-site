---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, contacts } from '../data/site';

const timeline = [
  { when: '2026-09', what: '小爪助手 v2.4（进行中）', desc: '接触和学习 AI Agent 后，我把小爪助手克隆下来作为主要实践项目，边运行边整理工具调用、权限和数据保存。' },
  { when: '2026-09', what: '重构 T2Video', desc: '把 2207 行的单文件拆成 8 个模块，补测试，也顺手清掉几处原来没有真正起作用的检查。' },
  { when: '2026-05', what: '试做 Reasonix GUI', desc: '给命令行工具做了一个 Electron 界面，主体用了 3 天。做完发现，窗口不一定比命令行更适合所有工作流。' },
  { when: '2026-02', what: '给旧项目补上版本控制', desc: '把 2024 年写的 T2Video 整理后存进 GitHub。同期还写过 C 盘清理脚本和几段 R 语言统计实验。' },
  { when: '2024-06', what: '第一次让程序操作电脑', desc: '做了一个会看屏幕、点鼠标和敲键盘的桌面操作员。这个项目让我开始认真关注 Agent 如何使用工具，以及人为什么愿意把操作交出去。' },
  { when: '2024', what: '开始做文生视频', desc: 'T2Video-DCOT 动笔。当时没用 git，代码在本地放了两年。后来回头整理，才发现里面已经有了现在常用的分步处理和逐步检查。' },
];

const concerns = [
  '安装别成为第一道门槛：双击、下一步、完成，不需要先装 Python，也不需要先申请一串密钥。',
  '把权限分开：普通操作尽量少打扰，安装代码或执行高风险动作时必须再确认。',
  '让成本有迹可循：能少一次截图、少发一段无关上下文，就别把它当成“以后再优化”。',
  '数据留在用户手里：本地优先，写盘有备份，导入导出清楚，卸载默认不删数据。',
];
---
<BaseLayout
  title="关于"
  description="颐安的个人网站，记录接触和学习 AI Agent 的过程，以及小爪助手这个主要实践项目。"
>
  <section class="page-head">
    <div class="wrap stack gap-sm">
      <nav class="crumb" aria-label="面包屑"><a href="/">首页</a><span aria-hidden="true">/</span><span class="faint">关于</span></nav>
      <span class="eyebrow">关于</span>
      <h1>我是颐安</h1>
      <p class="lead">{site.intro}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap two-col">
      <div class="article">
        <div class="about-head">
          <div class="avatar" aria-hidden="true">{site.initials}</div>
          <div class="stack gap-xs">
            <span class="mono faint">{site.location} · {site.status}</span>
            <p style="margin:0">
              目前主要在接触和学习 <b>AI Agent</b>，用 <b>Python</b> 和 <b>TypeScript</b> 做实践。
              小爪助手是目前最完整的学习成果，也做过桌面操作、Electron 图形界面和文生视频方面的尝试。
            </p>
          </div>
        </div>

        <h2>我怎么开始接触 Agent</h2>
        <p>
          我是在做桌面工具的过程中接触 AI Agent 的。2024 年第一次做让程序操作电脑的项目时，
          我把看屏幕、点鼠标和敲键盘这些能力一点点接起来，也第一次遇到工具调用、任务拆解和权限边界这些问题。
        </p>
        <p>
          后来我把小爪助手克隆下来，作为自己学习 Agent 的主要项目。它不是一篇教程，而是一个可以实际运行的桌面工具：
          我一边看代码和文档，一边运行、修改，再用测试确认自己是不是真的理解了。
        </p>
        <p>
          这个过程中我发现，Agent 最有意思的地方不只是模型能不能识别屏幕，
          而是它能不能安全地调用工具、在失败后继续，以及用户是否愿意把操作交给它。
        </p>
        <p>
          所以现在我会同时关注模型能力和工具本身：权限怎么分、数据会不会丢、第一次打开会不会卡住。
          小爪助手就是我目前把这些问题放在一起练习的地方。
        </p>

        <h2>最近更在意的事</h2>
        <ul>
          {concerns.map((t) => <li>{t}</li>)}
        </ul>

        <h2>还没做过什么</h2>
        <p>
          我不写 Rust；前端的 React 只到「能拼出界面、调通 IPC」的程度，做不了精致的视觉设计 ——
          小爪的界面是靠 QML 一点点调到顺眼的；我没做过高并发分布式系统，我的项目基本都是单机工具；
          R 只是拿来跑统计脚本，不是研究用的水平。
        </p>
        <p>
          所以如果要聊，Agent 工具调用、桌面端实现、权限边界和 Windows 打包会更对路。
        </p>

        <div class="callout">
          <span aria-hidden="true"><Icon name="spark" size={18} /></span>
          <div>
            <b>我现在比较相信的一句话</b><br />
            先把第一次打开会卡在哪想清楚，再决定要加什么。很多时候，少一个设置比多一个功能更有用。
          </div>
        </div>

        <h2>这个站会放什么</h2>
        <p>
          主要写我学习 AI Agent 时遇到的具体问题，以及小爪助手、桌面开发和打包发布中的记录。
          它不太像教程，更像一份边做边学的工作记录。
        </p>
      </div>

      <aside class="side">
        <div class="card">
          <span class="eyebrow">时间线</span>
          <div class="timeline" style="margin-top:1.2rem">
            {timeline.map((t) => (
              <div class="timeline__item">
                <span class="timeline__when">{t.when}</span>
                <div class="timeline__what">{t.what}</div>
                <div class="timeline__desc">{t.desc}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="card">
          <span class="eyebrow">联系我</span>
          <p style="margin:.7rem 0 1rem">
            邮箱、微信、QQ 都可以，我基本当天回；GitHub 上的 Issue 也会看。
            点一下就是复制。
          </p>
          <div class="stack gap-sm">
            <a class="btn btn--sm" href={site.github} target="_blank" rel="me noopener">
              <Icon name="github" size={14} />@0Sun-shine0
            </a>
            {contacts.map((c) => (
              <button class="btn btn--sm" type="button" data-copy={c.value} title={`点击复制${c.label}`}>
                <Icon name={c.icon} size={14} />{c.label}：{c.value}
              </button>
            ))}
          </div>
          <p class="mono faint" style="margin:1rem 0 0">常驻 {site.location}</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
