---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, contacts } from '../data/site';

const timeline = [
  { when: '2026-09', what: '小爪助手 v2.4（还在改）', desc: '我主导做的桌面工具，两周提交了 88 次。现在主要在收尾安装和自动更新。' },
  { when: '2026-09', what: '重构 T2Video', desc: '把单文件拆成 8 个模块，补上测试，也清掉几处原来没真正起作用的检查。' },
  { when: '2026-05', what: '试做 Reasonix GUI', desc: '给命令行工具做了个 Electron 界面，主体 3 天。做完发现多开一个窗口并不等于更顺手。' },
  { when: '2026-02', what: '给旧项目补上版本控制', desc: '把 2024 年写的 T2Video 整理后传上 GitHub。同期还写过 C 盘清理脚本和几段 R 统计实验。' },
  { when: '2024-06', what: '第一次让程序操作电脑', desc: '做了个会看屏幕、点鼠标、敲键盘的桌面操作员。它让我第一次认真想「人为什么愿意把操作交出去」。' },
  { when: '2024', what: '开始做文生视频', desc: 'T2Video-DCOT 动笔。当时没用 git，代码在本地放了两年。' },
];

const concerns = [
  '安装别成为第一道门槛：双击、下一步、完成，不用先装 Python，也不用先去申请密钥。',
  '权限分清：日常操作少打扰，安装代码和执行高风险命令时必须再问一次。',
  '成本看得见：能少截一张图、少发一段无关上下文，就别留到「以后再优化」。',
  '数据留给用户：本地优先，写盘有备份，导入导出说清楚，卸载默认不删数据。',
];
---
<BaseLayout
  title="关于"
  description="颐安的个人网站。小爪助手、T2Video 这些项目，以及做它们时真正卡住我的地方。"
>
  <section class="page-head">
    <div class="wrap stack gap-sm">
      <nav class="crumb" aria-label="面包屑"><a href="/">首页</a><span aria-hidden="true">/</span><span class="faint">关于</span></nav>
      <span class="eyebrow">关于</span>
      <h1>我是颐安</h1>
      <p class="lead">{site.intro}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap two-col">
      <div class="article">
        <div class="about-head">
          <div class="avatar" aria-hidden="true">{site.initials}</div>
          <div class="stack gap-xs">
            <span class="mono faint">{site.location} · {site.status}</span>
            <p style="margin:0">
              平时用 <b>Python</b> 和 <b>TypeScript</b> 写桌面工具。小爪助手是我主导做的项目，也是学 Agent 时练手的地方；
              另外做过桌面操作、Electron 界面和文生视频。
            </p>
          </div>
        </div>

        <h2>怎么走到这些项目上的</h2>
        <p>
          2024 年我做了个让程序替我操作电脑的项目：DeepSeek 拆任务，CNN 看屏幕，PyAutoGUI 点鼠标敲键盘。
          那时候我以为难点是「模型看不看得懂屏幕」。
        </p>
        <p>
          做完才发现不是。真正卡住我的是另一个问题：用户凭什么敢把键鼠交出去。
          识别得再准，只要用户不肯按「允许」，这东西就只能待在自己机器上。
        </p>
        <p>
          这个念头一直留着。做小爪助手的时候，它变成了很具体的东西 —— 权限怎么分级、审批卡片弹在哪、哪些动作永远要问；
          再往后又碰上数据丢失、安装门槛、模型成本这些事。
        </p>
        <p>
          所以现在我会同时盯着两头：模型能做什么，以及工具本身靠不靠得住。
        </p>

        <h2>最近更在意的事</h2>
        <ul>
          {concerns.map((t) => <li>{t}</li>)}
        </ul>

        <h2>还没做过什么</h2>
        <p>
          我不写 Rust；前端的 React 只到「能拼出界面、调通 IPC」的程度，做不了精致的视觉设计 ——
          小爪的界面是靠 QML 一点点调到顺眼的；我没做过高并发分布式系统，我的项目基本都是单机工具；
          R 只是拿来跑统计脚本，不是研究用的水平。
        </p>
        <p>
          所以如果要聊，Agent 工具调用、桌面端实现、权限边界和 Windows 打包会更对路。
        </p>

        <div class="callout">
          <span aria-hidden="true"><Icon name="spark" size={18} /></span>
          <div>
            <b>一个现在的习惯</b><br />
            动手之前先问「用户第一次打开会卡在哪」，再决定加什么。小爪助手里好几个功能就是这么做着做着被砍掉的。
          </div>
        </div>

        <h2>这个站会放什么</h2>
        <p>
          三样东西：做过的项目、写的时候撞上的具体问题、还有做完之后发现判断错了的地方。
          不做教程，也不打算把功能列全。
        </p>
      </div>

      <aside class="side">
        <div class="card">
          <span class="eyebrow">时间线</span>
          <div class="timeline" style="margin-top:1.2rem">
            {timeline.map((t) => (
              <div class="timeline__item">
                <span class="timeline__when">{t.when}</span>
                <div class="timeline__what">{t.what}</div>
                <div class="timeline__desc">{t.desc}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="card">
          <span class="eyebrow">联系我</span>
          <p style="margin:.7rem 0 1rem">
            邮箱、微信、QQ 都可以，我基本当天回；GitHub 上的 Issue 也会看。
            点一下就是复制。
          </p>
          <div class="stack gap-sm">
            <a class="btn btn--sm" href={site.github} target="_blank" rel="me noopener">
              <Icon name="github" size={14} />@0Sun-shine0
            </a>
            {contacts.map((c) => (
              <button class="btn btn--sm" type="button" data-copy={c.value} title={`点击复制${c.label}`}>
                <Icon name={c.icon} size={14} />{c.label}：{c.value}
              </button>
            ))}
          </div>
          <p class="mono faint" style="margin:1rem 0 0">常驻 {site.location}</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
